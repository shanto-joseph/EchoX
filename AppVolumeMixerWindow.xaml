<Window x:Class="EchoX.AppVolumeMixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="App Volume Mixer"
        Width="360"
        Height="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Background="#111416"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="MixerVolumeSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ForceCursor" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#53C028" Height="4" CornerRadius="2" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#24272C" Height="4" CornerRadius="2" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="24"
                                           Height="24"
                                           VerticalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="24" Height="24" Background="Transparent">
                                                    <Border x:Name="VolumeDot"
                                                            Width="14"
                                                            Height="14"
                                                            Background="#53C028"
                                                            CornerRadius="7"
                                                            BorderBrush="#111416"
                                                            BorderThickness="2"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="VolumeDot" Property="Width" Value="16"/>
                                                        <Setter TargetName="VolumeDot" Property="Height" Value="16"/>
                                                        <Setter TargetName="VolumeDot" Property="CornerRadius" Value="8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MixerScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Background" Value="#1A1D20"/>
            <Setter Property="Foreground" Value="#53C028"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                Margin="0,4"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#53C028">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#111416"
            BorderBrush="#2E3238"
            BorderThickness="1"
            CornerRadius="16"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="16,14"
                    BorderBrush="#2E3238"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Cursor="SizeAll"
                                MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <TextBlock Text="Per-App Volume"
                                   Foreground="#EDEDF0"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="DeviceText"
                                   Foreground="#8A9199"
                                   FontSize="11"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Click="CloseBtn_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="0"
                            Margin="12,0,0,0"
                            VerticalAlignment="Top">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="#8A9199"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              RecognizesAccessKey="True"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#EDEDF0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="ESC"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   FontSize="12"
                                   FontFamily="Consolas"
                                   FontWeight="SemiBold"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="16,14"
                        BorderBrush="#2E3238"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE767;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#53C028"
                                       FontSize="14"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="System Volume"
                                           Foreground="#EDEDF0"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="SystemOutputText"
                                           Foreground="#8A9199"
                                           FontSize="11"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SystemVolumeSlider"
                                    Grid.Column="0"
                                    Style="{StaticResource MixerVolumeSlider}"
                                    ValueChanged="SystemVolumeSlider_ValueChanged"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="SystemVolumeTextBlock"
                                       Grid.Column="1"
                                       Foreground="#53C028"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <TextBlock x:Name="EmptyStateText"
                               Text="No active apps are playing audio right now."
                               Foreground="#8A9199"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                    <ScrollViewer x:Name="SessionScrollViewer"
                                  Grid.Column="0"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="SessionScrollViewer_ScrollChanged">
                        <ItemsControl x:Name="SessionItemsControl" ItemsSource="{Binding Sessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,14"
                                            BorderBrush="#2E3238"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Width="22" Height="22" Margin="0,0,10,0">
                                                    <Image Source="{Binding IconSource}"
                                                           Width="20"
                                                           Height="20"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <TextBlock Text="{Binding FallbackGlyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="#53C028"
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding AppName}"
                                                               Foreground="#EDEDF0"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <ToggleButton Grid.Column="2"
                                                              Width="30"
                                                              Height="30"
                                                              Margin="10,0,0,0"
                                                              IsChecked="{Binding IsMuted}"
                                                              Cursor="Hand"
                                                              Background="Transparent"
                                                              BorderThickness="0">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="9">
                                                                <TextBlock x:Name="MuteIcon"
                                                                           Text="{Binding MuteGlyph}"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="13"
                                                                           Foreground="#8A9199"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="MuteIcon" Property="Foreground" Value="#EDEDF0"/>
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="MuteIcon" Property="Foreground" Value="#E96C6C"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                            </Grid>

                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0"
                                                        Style="{StaticResource MixerVolumeSlider}"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        Value="{Binding Volume}"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding VolumeText}"
                                                           Foreground="#53C028"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                        <ScrollBar x:Name="SessionScrollBar"
                                   Grid.Column="1"
                                   Margin="0,4,0,4"
                                   Minimum="0"
                                   Maximum="0"
                                   ViewportSize="1"
                                   Visibility="Collapsed"
                                   Style="{StaticResource MixerScrollBar}"
                                   ValueChanged="SessionScrollBar_ValueChanged"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
